{
  "name": "social-production-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:vite": "vite dev",
    "dev:lan": "vite dev --host 0.0.0.0",
    "build": "npm run paraglide && vite build",
    "start": "node build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "npm run check && npm run build",
    "format": "prettier --write \"src/**/*.{ts,svelte}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte}\""
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-message-format": "^4.4.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.5",
    "svelte-check": "^3.8.6",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "devalue": "^5.8.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.1",
    "maplibre-gl": "^5.24.0"
  }
}
