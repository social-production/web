# Pick ONE backend. Change this file, then restart `npm run dev`.
# Data does NOT transfer between backends — each has its own database.

# ========== Option A: FastAPI (default production-shaped local) ==========
VITE_BACKEND=fastapi
VITE_USE_DEV_PROXY=true
# VITE_API_URL=http://localhost:8000

# ========== Option B: Supabase (local parity / hosted beta path) ==========
# Comment out Option A, uncomment below, then restart Vite.
# Prerequisites: web-supabase `npm run start` + `npm run functions:serve`
# Browser uses same-origin /functions/v1 + /auth/v1; Vite proxies to VITE_SUPABASE_URL.
# VITE_BACKEND=supabase
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
# VITE_USE_DEV_PROXY=false
# Optional: VITE_SUPABASE_SAME_ORIGIN=false  # force direct browser → :54321 (not recommended)

# Other providers (not for daily use):
# VITE_BACKEND=holochain
# VITE_BACKEND=template

# LAN testing: run ./scripts/lan-dev.sh — it writes the correct LAN URL for FastAPI mode.
# Always open http://localhost:5173 for Supabase mode (sessions are per-origin).
