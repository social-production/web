VITE_BACKEND=fastapi
# Alternate providers (stubs until implemented):
# VITE_BACKEND=supabase
# VITE_BACKEND=holochain
# VITE_BACKEND=template
# Local dev (recommended): proxy API through Vite — copy to .env.local:
VITE_USE_DEV_PROXY=true
# Direct backend URL (only if not using the dev proxy):
# VITE_API_URL=http://localhost:8000
# LAN testing: run ./scripts/lan-dev.sh — it writes the correct LAN URL to .env.local
