# Local settings for the site. Restart `npm run dev` after changing this file.

# The API this site talks to (web-backend).
VITE_BACKEND=fastapi
VITE_USE_DEV_PROXY=true
# VITE_API_URL=http://localhost:8000
# Live site only. true makes the browser call this website, which forwards /api to the API.
# VITE_API_SAME_ORIGIN=false

# Other providers (not for daily use):
# VITE_BACKEND=holochain
# VITE_BACKEND=template

# Product switches. Use the words true or false. Restart Vite after changing them.
# Frontend values are baked in at build time (Railway rebuilds when you change them).
# Signup defaults on when unset. PWA and push default off when unset.
VITE_SIGNUP_ENABLED=true
VITE_PWA_ENABLED=false
VITE_PUSH_ENABLED=false
# Public Cloudflare Turnstile site key. Leave empty to skip the signup captcha locally.
VITE_TURNSTILE_SITE_KEY=

# LAN testing: run ./scripts/lan-dev.sh. It writes the correct LAN URL here.
